<odoo>
    <record id="base_multi_image_image_form_reorder" model="ir.ui.view">
        <field name="name">base.multi.image.image.form.reorder</field>
        <field name="model">base_multi_image.image</field>
        <field name="inherit_id" ref="base_multi_image.image_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[.//field[@name='name']]" position="before">
                <xpath expr="//page[.//field[@name='image_1920']]" position="move"/>
            </xpath>
        </field>
    </record>
</odoo>
