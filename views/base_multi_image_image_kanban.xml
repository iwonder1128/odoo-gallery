<odoo>
    <record id="base_multi_image_image_kanban_bigger" model="ir.ui.view">
        <field name="name">base.multi.image.image.kanban.bigger</field>
        <field name="model">base_multi_image.image</field>
        <field name="inherit_id" ref="base_multi_image.image_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='image_128']" position="attributes">
                <attribute name="style">width: 220px; height: 220px;</attribute>
            </xpath>
        </field>
    </record>
</odoo>
